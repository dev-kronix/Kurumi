# MongoDB é opcional. Sem essa variável, a Kurumi usa armazenamento JSON local.
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/kurumi

# Use production ou development
NODE_ENV=production

# Chaves opcionais usadas por alguns plugins de IA
GEMINI_API_KEY=
REMOVEBG_API_KEY=
NOVA_API_KEY=
